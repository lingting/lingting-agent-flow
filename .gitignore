.idea/

.plan/
# 构建产物
/bin/
# 发布制品输出目录（由仓库根目录 Makefile 的 release-dist 生成）
/dist/release/


# CI 测试产物目录（仅 CI 把 TMPDIR 指向这里，本地不会产生）
/.test-artifacts/
# 前端生产构建产物写入 Go 的嵌入包目录，只保留占位文件
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# 运行期数据与工作区
#
# 忽略任意层级下的 .agentflow 目录：除仓库根目录外，测试用例若误用相对路径也会
# 在包目录下生成该目录，这里一并兜住，避免运行期数据被提交。
.agentflow/
# 本地配置（示例配置之外的配置文件不入库）
/configs/agentflow.yaml

# 测试配置：忽略 tests/config 下的真实配置文件，只提交 example.* 示例文件。
#
# 按文件名逐个放行而不是按前缀通配：新增示例文件时必须在下方显式追加一行，
# 避免误把真实配置（可能包含主机地址、私钥路径）提交进版本库。
/tests/config/*
!/tests/config/example.ssh.yml
!/tests/config/example.pi.yml
!/tests/config/example.docker.yml
!/tests/config/example.git.yml
